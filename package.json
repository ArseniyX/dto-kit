{
  "name": "dto-kit",
  "version": "0.0.1",
  "description": "Decorator-based DTO validation and transformation for TypeScript. TC39 standard decorators, no reflect-metadata, Standard Schema compatible, with a NestJS pipe and a class-validator codemod.",
  "keywords": [
    "dto",
    "validation",
    "transformation",
    "decorators",
    "class-validator",
    "class-transformer",
    "standard-schema",
    "nestjs",
    "typescript",
    "codemod"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.cjs"
      }
    },
    "./codemod": {
      "import": {
        "types": "./dist/codemod/index.d.ts",
        "default": "./dist/codemod/index.js"
      },
      "require": {
        "types": "./dist/codemod/index.d.ts",
        "default": "./dist/codemod/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "author": {
    "name": "ArseniyX",
    "url": "https://github.com/ArseniyX"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArseniyX/dto-kit.git"
  },
  "devDependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "esbuild": "^0.28.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "validator": "^13.15.35"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "bin": {
    "dto-kit-codemod": "./dist/codemod/cli.js"
  }
}
